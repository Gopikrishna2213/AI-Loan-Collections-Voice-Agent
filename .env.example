# Copy this file to .env and fill in real values. Never commit .env.
# Nothing in source code reads secrets directly — only these env vars do.

# --- Dashboard -> Backend ---
# URL of the running FastAPI backend, used by dashboard/app.py.
BACKEND_URL=http://localhost:8000

# --- Vapi assistant config rendering (scripts/render_vapi_config.py) ---
# Public HTTPS URL of your DEPLOYED backend (Render/Fly.io/Railway/etc),
# OR a temporary ngrok tunnel URL for local testing — see
# docs/VAPI_DEPLOYMENT.md §1 Option A ("ngrok http 8000", then use the
# printed https://....ngrok-free.app URL here). This becomes the tool
# "server.url" Vapi calls during a real phone call. BACKEND_URL above is
# reused for this if you only need one value; set it to the public URL
# (not localhost) before rendering for real calls. Note: free-tier ngrok
# URLs change every restart — re-run render_vapi_config.py with the new
# URL each time the tunnel restarts.

# ElevenLabs voice ID to use for Maya. Pick one from your ElevenLabs
# account (Voice Library or a cloned voice) — cannot be supplied for you.
VAPI_VOICE_ID=

# Vapi API key, used only by scripts/render_vapi_config.py --deploy to
# create/update the assistant via Vapi's API. Leave unset to just render
# the config file and paste it into the Vapi dashboard manually instead.
# SERVER-SIDE ONLY. Never read by dashboard/app.py, never sent to the
# browser — do not confuse this with VAPI_PUBLIC_KEY below.
VAPI_API_KEY=

# Set after the first successful deploy so re-running --deploy updates
# the SAME assistant (PATCH) instead of creating a new one each time.
# Also used directly by dashboard/app.py's "🎙️ Web Call" tab to tell the
# browser which already-deployed assistant to call — an assistant ID is
# not a secret, so this is safe to expose client-side.
VAPI_ASSISTANT_ID=

# Phone number ID (from the Vapi dashboard, Phone Numbers tab) to attach
# the assistant to. Not consumed by any script here — recorded for
# reference when following docs/VAPI_DEPLOYMENT.md.
VAPI_PHONE_NUMBER_ID=

# --- Dashboard -> Vapi Web SDK (browser voice calls) ---
# Vapi's PUBLIC/browser key (Vapi dashboard -> Settings -> API Keys ->
# "Public Key" — NOT the private API key above). By design this key can
# only start calls from a browser; it cannot manage your Vapi account, so
# it is safe to ship to client-side JS. Required for the "🎙️ Web Call" tab.
VAPI_PUBLIC_KEY=
